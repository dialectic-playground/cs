<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dp-hello</AssemblyName>
    <RootNamespace>DialecticPlayground.Hello.Cli</RootNamespace>
    <IsPackable>false</IsPackable>

    <!-- make all publishes one framework-dependent, single-file native executable (apphost)
         for the build machine's runtime identifier. Listing every supported RID keeps
         packages.lock.json identical on all operating systems. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- The single-file analyzer would add an implicit Microsoft.NET.ILLink.Tasks reference
         whose version follows the installed SDK, which breaks locked-mode restores across
         machines. The code does not use Assembly.Location or other single-file hazards. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <!-- BIN_DIR holds the executable only. -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../DpHello.Core/DpHello.Core.csproj" />
  </ItemGroup>

</Project>
